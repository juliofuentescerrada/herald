{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      },
      "alwaysLoad": true
    },
    "aspire": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/scripts/aspire-mcp\""
      ]
    }
  }
}
