<Project>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="Messaging and persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="WolverineFx" Version="6.62.0" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.62.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.62.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.62.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.62.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.62.0" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
