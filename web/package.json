{
  "name": "herald",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:public": "node dist/public/server/server.mjs",
    "lint": "ng lint",
    "lint:boundaries": "node boundary-fixtures/check.mjs",
    "test:all": "ng test admin --watch=false && ng test public --watch=false && ng test catalogue --watch=false && ng test ui --watch=false && ng test api-client --watch=false",
    "build:all": "ng build admin && ng build public && ng build catalogue",
    "test:ssr": "ng build public --configuration development --output-path dist/public-dev && node ssr-checks/isolation.mjs dist/public-dev",
    "start:admin": "node projects/admin/write-runtime-config.mjs && ng serve admin --port ${PORT:-4200}",
    "start:public": "ng serve public --port ${PORT:-4300}",
    "api:generate": "node projects/api-client/generate.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "@azure/msal-browser": "5.29.0",
    "@floating-ui/dom": "1.8.0",
    "@tabler/icons": "3.50.0",
    "@tabler/icons-angular": "3.50.0",
    "@tanstack/angular-query-experimental": "5.107.1",
    "express": "^5.1.0",
    "ng-primitives": "0.131.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "orval": "8.47.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
