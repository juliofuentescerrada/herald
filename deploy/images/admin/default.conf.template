# nginx's entry point substitutes the environment's variables (HERALD_API_URL) into this template at start.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Written at start by 40-herald-runtime-config.sh; never cached, as main.ts asks.
    location = /runtime-config.json {
        alias /tmp/herald/runtime-config.json;
        add_header Cache-Control "no-store";
    }

    # The API's ingress is internal to the environment (m4-cloud-runtime D-5): the browser reaches it through this origin.
    location /api/ {
        proxy_pass ${HERALD_API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Client-side routes fall back to the application.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
