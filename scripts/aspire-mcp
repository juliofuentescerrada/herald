#!/usr/bin/env bash
# Aspire's MCP server for Claude Code (harness-engineering D-13), at the AppHost's Aspire version, so the agent can
# read resources, logs and traces of a running AppHost. Declared in .mcp.json; installed on first use by dnx.
set -euo pipefail
cd "$(dirname "$0")/.."
version=$(sed -n 's/.*Aspire.Hosting.PostgreSQL" Version="\([^"]*\)".*/\1/p' Directory.Packages.props)
exec dnx --yes "aspire.cli@${version}" -- agent mcp --nologo --non-interactive "$@"
