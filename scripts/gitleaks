#!/usr/bin/env bash
# Gitleaks at the version Herald pins, verified by its checksum (private-data-guard D-2). The version and checksums
# live here only. Installs into $HERALD_TOOLS (default ~/.local/bin) when missing or at another version, then runs it
# with the given arguments and the repository's .gitleaks.toml:
#   scripts/gitleaks --install          install only (scripts/bootstrap, CI)
#   scripts/gitleaks --installed ARGS   run only if already installed, else say so and succeed (.githooks/pre-commit)
#   scripts/gitleaks ARGS               install if needed, then run (CI)
set -euo pipefail
version=8.30.1
# A function, not an associative array, so macOS's bash 3.2 runs it too.
checksum() {
  case "$1" in
    linux_x64) echo 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
    linux_arm64) echo e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
    darwin_x64) echo dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709 ;;
    darwin_arm64) echo b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
  esac
}
tools="${HERALD_TOOLS:-$HOME/.local/bin}"
binary="$tools/gitleaks"
root="$(cd "$(dirname "$0")/.." && pwd)"

current() { [ -x "$binary" ] && [ "$("$binary" version 2>/dev/null)" = "$version" ]; }

install() {
  current && return 0
  local os arch platform
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) arch=unknown ;; esac
  platform="${os}_${arch}"
  local expected
  expected=$(checksum "$platform")
  if [ -z "$expected" ]; then
    echo "No pinned gitleaks for ${platform}: put gitleaks ${version} at ${binary} by hand." >&2
    return 1
  fi
  temp=$(mktemp -d)
  trap 'rm -rf "$temp"' EXIT
  local archive="gitleaks_${version}_${platform}.tar.gz" actual
  curl -fsSL -o "$temp/$archive" "https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive}"
  if command -v sha256sum >/dev/null; then actual=$(sha256sum "$temp/$archive"); else actual=$(shasum -a 256 "$temp/$archive"); fi
  if [ "${actual%% *}" != "$expected" ]; then
    echo "The gitleaks archive does not match its pinned checksum: not installed." >&2
    return 1
  fi
  tar -xzf "$temp/$archive" -C "$temp" gitleaks
  mkdir -p "$tools"
  mv "$temp/gitleaks" "$binary"
}

case "${1:-}" in
  --install) install; exit $? ;;
  --installed)
    shift
    if ! current; then
      echo "gitleaks ${version} is not installed: secrets were not scanned here (CI scans them). Run scripts/bootstrap." >&2
      exit 0
    fi
    ;;
  *) install ;;
esac
# --verbose names the file, the line and the rule of each finding; --redact hides the secret itself.
exec "$binary" "$@" --config "$root/.gitleaks.toml" --no-banner --redact --verbose
