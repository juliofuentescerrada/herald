#!/usr/bin/env bash
# Runs CI's checks with short output: one line per step, and on failure only the error lines
# and the end of that step's log. Full logs stay in the printed directory.
# Usage: scripts/check [rules|dotnet|web|all]   (default: all)
set -uo pipefail
export NO_COLOR=1 FORCE_COLOR=0
cd "$(dirname "$0")/.."
target="${1:-all}"
logs="$(mktemp -d "${TMPDIR:-/tmp}/herald-check.XXXXXX")"
failed=0

step() {
  local name="$1"; shift
  local log="$logs/$(echo "$name" | tr -c 'a-zA-Z0-9' '-').log"
  local start=$SECONDS
  if (eval "$@") >"$log" 2>&1; then
    printf 'ok    %-28s %4ss\n' "$name" $((SECONDS - start))
  else
    failed=1
    printf 'FAIL  %-28s %4ss  %s\n' "$name" $((SECONDS - start)) "$log"
    sed -i 's/\x1b\[[0-9;]*m//g' "$log"
    grep -E -i -B1 '(^|[^a-z])(error|failed|fail|✘|×|assert)' "$log" | grep -v -i -E 'warn|^--$' | awk '!seen[$0]++' | head -n 30 | cut -c1-300
    echo '  ...'
    tail -n 15 "$log" | cut -c1-300
  fi
}

unchanged() {
  local changes
  changes="$(git status --porcelain -- "$@")"
  [ -z "$changes" ] || { echo "Generated files are stale; commit them:"; echo "$changes"; return 1; }
}

if [ "$target" = rules ] || [ "$target" = all ]; then
  step "rules" node scripts/rules.mjs
  step "spec coverage" node scripts/spec-coverage.mjs
  step "rules tests" "node --test scripts/*.test.mjs"
fi

if [ "$target" = dotnet ] || [ "$target" = all ]; then
  docker info >/dev/null 2>&1 || echo "note: Docker is not running; the tests need it (see CLAUDE.md)."
  step "dotnet restore" dotnet restore Herald.slnx
  step "dotnet format" dotnet format Herald.slnx --verify-no-changes --no-restore
  step "dotnet build" dotnet build Herald.slnx -c Release --no-restore
  step "wolverine codegen current" "dotnet run --project src/Herald.Host -c Release --no-build -- codegen delete && dotnet run --project src/Herald.Host -c Release --no-build -- codegen write && unchanged src/Herald.Host/Internal/Generated"
  step "dotnet test" dotnet test --solution Herald.slnx -c Release --no-build
fi

if [ "$target" = web ] || [ "$target" = all ]; then
  step "pnpm install" "cd web && pnpm install --frozen-lockfile"
  step "openapi client current" "cd web && pnpm api:generate && cd .. && unchanged web/projects/api-client"
  step "lint" "cd web && pnpm lint"
  step "lint boundaries" "cd web && pnpm lint:boundaries"
  step "test" "cd web && pnpm test:all"
  step "ssr isolation" "cd web && pnpm test:ssr"
  step "build" "cd web && pnpm build:all"
fi

[ "$failed" = 0 ] && echo "all checks passed (logs: $logs)"
exit "$failed"
